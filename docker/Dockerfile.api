FROM node:20-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @food-ordering/config build
RUN pnpm --filter @food-ordering/types build
RUN pnpm --filter @food-ordering/database db:generate
RUN pnpm --filter @food-ordering/database build
RUN pnpm --filter @food-ordering/validation build
RUN pnpm --filter @food-ordering/api build

EXPOSE 4000
CMD ["pnpm", "--filter", "@food-ordering/api", "start:prod"]
