# Environment configuration
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/food_ordering?schema=public"

# Redis Cache & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# LINE Integration
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_LIFF_ID=your_line_liff_id

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id

# Slip2Go API
SLIP2GO_API_URL=https://api.slip2go.com/v1
SLIP2GO_API_SECRET=your_slip2go_api_secret

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_PRODUCTS_BUCKET=food-products
MINIO_SLIPS_BUCKET=food-slips
MINIO_RECEIPTS_BUCKET=food-receipts
MINIO_DELIVERY_BUCKET=food-delivery
